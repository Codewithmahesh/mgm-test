# Copy this file to .env.local and fill in the values.
MONGODB_URI=mongodb://127.0.0.1:27017/examly
# Any random string of 32+ characters, e.g. from: openssl rand -base64 48
AUTH_SECRET=
GEMINI_API_KEY=
# One model, or several separated by commas: when one hits its rate limit the next is used.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# SMTP server for verification-code (OTP) emails. For Gmail, use smtp.gmail.com, port 465,
# your Gmail address, and an App Password (Google Account > Security > App passwords).
# Leave SMTP_HOST empty in development to print the codes in the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender, e.g. "MGM Exam Portal <exams@example.edu>". Defaults to SMTP_USER.
MAIL_FROM=
# Public address of the portal, e.g. https://exams.mgmcen.ac.in. Emails use it for the logo and the
# "Go to the room" buttons; without it they are sent without them.
APP_URL=
# Time zone for dates in emails (servers usually run on UTC).
APP_TIME_ZONE=Asia/Kolkata

# Scheduled exams (20-minute reminders, auto-opening rooms) and background AI generations. A normal server (next start)
# checks every minute by itself. On serverless hosts such as Vercel, call this every minute from a cron
# (Vercel Cron, or a free service like cron-job.org):
#   GET /api/cron/schedule   with header   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Email domains faculty may add to the student list (comma separated). Leave empty to allow any.
STUDENT_EMAIL_DOMAINS=mgmcen.ac.in

# Code a new faculty member must enter to create an account (share it only with faculty).
# Leave empty to allow anyone to sign up as faculty (not recommended: faculty can see student data).
FACULTY_SIGNUP_CODE=

# ── Code Compiler Backend ──────────────────────────────────────────────────────
# Option 1 (Recommended): Self-hosted Piston Docker container (100% free, unlimited)
# Run: docker run --privileged -p 2000:2000 -v piston_data:/piston/data --restart unless-stopped -d ghcr.io/engineer-man/piston
PISTON_API_URL=http://localhost:2000

# Option 2: Judge0 CE via RapidAPI (50 requests/day free)
# JUDGE0_API_KEY=
# JUDGE0_SELF_HOSTED_URL=http://localhost:2358


# Optional GitHub token (no scopes needed) for the mobile app's GitHub stats (/api/coding-stats/github).
# Without it GitHub allows only 60 requests an hour from the server's IP.
GITHUB_TOKEN=
